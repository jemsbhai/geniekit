# Copy to .env (which is gitignored) or set in your shell. Never commit real tokens.

# Synapse personal access token with "view" and "download" scope.
# Create one at https://www.synapse.org -> your profile -> Settings -> Personal Access Tokens.
# Downloading GENIE BPC files also requires an approved GENIE access request.
SYNAPSE_AUTH_TOKEN=replace-me

# Where geniekit stores downloaded release files (default: ./data/genie_bpc).
GENIEKIT_DATA_DIR=./data/genie_bpc
